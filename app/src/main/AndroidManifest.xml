<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="facebook.video.downloader.savefrom.fb.saver.fast" />
        <package android:name="twittervideodownloader.twitter.videoindir.savegif.twdown" />
        <package android:name="tiktok.video.downloader.nowatermark.tiktokdownload" />
        <package android:name="pin.pinterest.video.downloader.forpinterest.pinsaver" />
        <package android:name="statussaver.videodownloader.downloadstatus.savestatus.storysaver" />
        <package android:name="instagram.video.downloader.story.saver.ig" />
        <package android:name="instagram.video.downloader.story.saver.ig.insaver" />
        <package android:name="com.video.instagram.story.downloader" />
        <package android:name="ins.freevideodownload.pro" />
        <package android:name="com.fasterhotbank.hvideofastdownloader" />
        <package android:name="instasaver.videodownloader.photodownloader.repost" />
        <package android:name="donwloader.ins.fb.twitter.videodownloader" />
        <package android:name="videodownloader.instagram.videosaver" />
        <package android:name="videoeditor.videomaker.trim.music.videoeditorforyoutube" />
        <package android:name="com.brightstory.videodownload" />
        <package android:name="com.story.downloader.reels.videodownloader.repost.fast.save.video.photos" />
        <package android:name="com.instadownloader.instasave.igsave.ins" />
        <package android:name="com.insta.downloader.saver.instake.ig.save.new" />
        <package android:name="indownloader.instsaver.insaver.video.downloader.story.downloader" />
        <package android:name="com.hooyee.downloaderinstag.photo.video.stories.saver.new" />
        <package android:name="photo.video.instasaveapp" />
        <package android:name="music.videomaker.editor.tempo.vinkle.beat.vunkle.effect" />
        <package android:name="instasave.reels.video.story.ig.instagram.download" />
        <package android:name="com.shirokovapp.instasave" />

        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
        <intent>
            <action android:name="com.applovin.am.intent.action.APPHUB_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="com.android.vending.billing.InAppBillingService.BIND" />
        </intent>
    </queries>

    <application
        android:name=".VideoDownloaderApp"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="UnusedAttribute"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:theme="@android:style/Theme.NoDisplay"
            android:name=".ui.home.ShareActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <activity
            android:name=".ui.player.PlayerActivity"
            android:configChanges="uiMode"
            android:exported="false" />
        <activity
            android:name=".ui.mock.MockActivity"
            android:configChanges="uiMode"
            android:exported="false" />
        <activity
            android:name=".ui.faq.FaqActivity"
            android:configChanges="uiMode"
            android:exported="false" />
        <activity
            android:name=".ui.howTo.HowToDownloadActivity"
            android:configChanges="uiMode"
            android:exported="false" />
        <activity
            android:name=".ui.plans.PlansActivity"
            android:configChanges="uiMode"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <meta-data android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="true" />

        <activity
            android:name=".ui.splash.SplashActivity"
            android:configChanges="uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask" />

        <receiver
            android:name=".common.download.DownloadCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".common.download.DownloadProgressReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.instagram.video.downloader.Download_In_Progress" />
                <action android:name="com.instagram.video.downloader.Download_Post_Completed" />
            </intent-filter>
        </receiver>


        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>

</manifest>